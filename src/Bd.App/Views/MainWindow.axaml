<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bd.Core.ViewModels"
        xmlns:dolt="using:Bd.Core.Dolt"
        xmlns:controls="using:Bd.App.Controls"
        x:Class="Bd.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Bd.Ui · beads 树"
        Icon="/Assets/beads.ico"
        WindowStartupLocation="CenterScreen"
        Width="1240"
        Height="780"
        MinWidth="1000"
        MinHeight="640">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="/Assets/beads.png" Width="26" Height="26" VerticalAlignment="Center" />
          <TextBlock Text="Bd.Ui" Classes="h1" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding CurrentProject, Mode=TwoWay}"
                    IsVisible="{Binding IsProjectSwitcherVisible}"
                    VerticalAlignment="Center" MinWidth="200" MaxWidth="340">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dolt:ProjectInfo">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="⟳" Classes="ghost" Command="{Binding ReloadProjectsCommand}"
                  IsVisible="{Binding IsProjectSwitcherVisible}" ToolTip.Tip="刷新项目列表" />
          <TextBlock Text="{Binding RepoText}" Classes="muted" VerticalAlignment="Center"
                     MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="⟳ 项目" Classes="ghost" Command="{Binding ReloadProjectsCommand}"
                  IsVisible="{Binding IsProjectSwitcherVisible}"
                  ToolTip.Tip="刷新项目列表（与左上角 ⟳ 相同）" />
          <Button Content="＋ 新建" Classes="primary" Click="OnCreateClick" />
          <Button Content="主题" Classes="ghost" Command="{Binding ToggleThemeCommand}" />
          <Button Content="⚙ 设置" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="设置（Ctrl+,）" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="460,4,*">
      <ContentControl Grid.Column="0" Content="{Binding Board}" />

      <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrushSoft}"
                    ResizeDirection="Columns" />

      <Border Grid.Column="2" Background="{DynamicResource AppBackground}"
              BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0">
        <Grid>
          <ContentControl Content="{Binding Detail}" IsVisible="{Binding IsDetailOpen}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                      IsVisible="{Binding !IsDetailOpen}">
            <TextBlock Text="◫" Classes="h1" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="在左侧选择一个任务查看详情" Classes="muted" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
            Padding="16,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"
                       IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" Classes="tiny"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <controls:ToastHost Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,20,20" DataContext="{Binding Toasts}" />
  </Grid>
</Window>
