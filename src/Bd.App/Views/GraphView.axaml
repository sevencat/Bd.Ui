<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bd.Core.ViewModels"
             xmlns:controls="using:Bd.App.Controls"
             x:Class="Bd.App.Views.GraphView"
             x:DataType="vm:GraphViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,16,16">
    <Border Grid.Row="0" Classes="panel" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="依赖图" Classes="h1" VerticalAlignment="Center" />
          <TextBox Width="170" PlaceholderText="中心任务 ID"
                   Text="{Binding RootId, Mode=TwoWay}" />
          <TextBlock Text="深度" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="80" ItemsSource="{Binding Depths}"
                    SelectedItem="{Binding Depth, Mode=TwoWay}" />
          <Button Content="刷新" Classes="ghost" Command="{Binding RefreshCommand}" />
          <ComboBox Width="130" ItemsSource="{Binding DependencyTypes}"
                    SelectedItem="{Binding SelectedDependencyType, Mode=TwoWay}" />
          <TextBox Width="150" PlaceholderText="被依赖 ID"
                   Text="{Binding NewTargetId, Mode=TwoWay}" />
          <Button Content="添加依赖" Command="{Binding AddDependencyCommand}" />
          <TextBox Width="150" PlaceholderText="解除目标 ID"
                   Text="{Binding RemoveTargetId, Mode=TwoWay}" />
          <Button Content="解除" Classes="danger" Command="{Binding RemoveDependencyCommand}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="4,8,0,0">
      <TextBlock Text="{Binding Summary}" Classes="muted" />
      <TextBlock Text="拖拽节点到另一节点即可连线" Classes="tiny" VerticalAlignment="Center" />
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" />
    </StackPanel>

    <Border Grid.Row="2" Classes="panel" Margin="0,8,0,0" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Panel Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
          <controls:DependencyGraphControl x:Name="GraphCanvas"
                                           Nodes="{Binding Nodes}"
                                           Edges="{Binding Edges}"
                                           RootId="{Binding RootId}"
                                           NodeSelected="OnNodeSelected"
                                           ConnectionRequested="OnConnectionRequested" />
        </Panel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
