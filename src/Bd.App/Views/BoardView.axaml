<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bd.Core.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Bd.App.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="12,10,8,12">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
      <Button Content="展开" Classes="ghost" Command="{Binding ExpandAllCommand}" />
      <Button Content="折叠" Classes="ghost" Command="{Binding CollapseAllCommand}" />
      <Button Content="刷新" Classes="ghost" Command="{Binding RequestRefreshCommand}"
              ToolTip.Tip="重新从 Dolt 拉取任务；切换下方筛选后需点这里才生效" />
      <CheckBox Content="显示已关闭" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                IsChecked="{Binding ShowClosed, Mode=TwoWay}"
                ToolTip.Tip="勾选后看板与任务树包含 Closed 任务；切换不会自动刷新，需手动点「刷新」" />
      <TextBlock Text="待刷新" Classes="tiny" Foreground="{DynamicResource WarningBrush}"
                 VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsStale}"
                 ToolTip.Tip="筛选范围已修改，点「刷新」后生效" />
    </StackPanel>

    <TextBlock Grid.Row="1" Margin="4,8,0,0" Foreground="{DynamicResource DangerBrush}"
               Text="{Binding ErrorMessage}" TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

    <Border Grid.Row="2" Classes="panel" Margin="0,10,0,0" Padding="4">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="6,2,6,6">
          <TextBlock Classes="muted" Text="任务树" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="tiny"
                     Text="{Binding TotalCount, StringFormat='共 {0} 项'}" VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="1" Classes="rows" ItemsSource="{Binding TreeRows}"
                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BoardTreeNodeViewModel">
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Height="28"
                    Background="Transparent"
                    DoubleTapped="OnTreeRowDoubleTapped"
                    ToolTip.Tip="{Binding Card.StatusText}">
                <Border Width="{Binding IndentWidth}" />
                <Button Grid.Column="1" Classes="ghost" Width="24" Height="24" Padding="0"
                        Margin="0,0,2,0" VerticalAlignment="Center" FontSize="15"
                        Content="{Binding ToggleGlyph}" Command="{Binding ToggleCommand}"
                        IsVisible="{Binding HasChildren}"
                        ToolTip.Tip="{Binding ChildCountText}" />
                <Border Grid.Column="1" Width="24" Margin="0,0,2,0"
                        IsVisible="{Binding !HasChildren}" />
                <TextBlock Grid.Column="2" Text="{Binding TypeGlyph}" Classes="tiny"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="3" Text="{Binding StatusGlyph}" VerticalAlignment="Center"
                           Margin="0,0,6,0" Width="12" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Grid.Column="4" Text="{Binding Card.Title}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" Text="{Binding ProgressText}" Classes="tiny"
                           VerticalAlignment="Center" Margin="8,0,6,0" />
                <TextBlock Grid.Column="6" Text="✓" VerticalAlignment="Center"
                           Foreground="{DynamicResource SuccessBrush}"
                           IsVisible="{Binding IsComplete}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="6,6,6,2">
          <TextBlock Classes="tiny" Text="暂无任务" IsVisible="{Binding IsTreeEmpty}" />
          <TextBlock Classes="tiny" Text="{Binding LastLoadedText, StringFormat='上次刷新 {0}'}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
