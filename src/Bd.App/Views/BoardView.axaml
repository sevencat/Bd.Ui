<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bd.Core.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Bd.App.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,16,16">
    <Border Grid.Row="0" Classes="panel" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="新建任务" Classes="primary" Command="{Binding CreateTaskCommand}" />
          <TextBox x:Name="SearchBox" Width="220" PlaceholderText="搜索 ID 或标题"
                   Text="{Binding Filter.SearchText, Mode=TwoWay}" />
          <ComboBox Width="110" ItemsSource="{Binding Filter.Types}"
                    SelectedItem="{Binding Filter.SelectedType, Mode=TwoWay}" />
          <ComboBox Width="90" ItemsSource="{Binding Filter.Priorities}"
                    SelectedItem="{Binding Filter.SelectedPriority, Mode=TwoWay}" />
          <TextBox Width="150" PlaceholderText="标签，逗号分隔"
                   Text="{Binding Filter.LabelsText, Mode=TwoWay}" />
          <CheckBox Content="含归档" IsChecked="{Binding Filter.IncludeArchived, Mode=TwoWay}" />
          <Button Content="清除" Classes="ghost" Command="{Binding Filter.ClearCommand}" />
          <Button Content="刷新" Classes="ghost" Command="{Binding RefreshCommand}" />
          <TextBlock Classes="muted" VerticalAlignment="Center"
                     Text="{Binding TotalCount, StringFormat='共 {0} 项'}" />
          <TextBlock Classes="tiny" VerticalAlignment="Center"
                     Text="{Binding LastLoadedText, StringFormat='上次 {0}'}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="1" Margin="4,8,0,0" Foreground="{DynamicResource DangerBrush}"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

    <ItemsControl Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding Columns}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:BoardColumnViewModel">
          <Border Classes="panel" Margin="0,0,10,0" Padding="10"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="OnColumnDragOver"
                  DragDrop.Drop="OnColumnDrop">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                <Border Width="8" Height="8" CornerRadius="4"
                        Background="{Binding Accent, Converter={StaticResource HexBrush}}" />
                <TextBlock Text="{Binding Title}" Classes="h2" />
                <Border Background="{DynamicResource PanelAltBackground}" CornerRadius="9" Padding="7,0">
                  <TextBlock Text="{Binding Count}" Classes="tiny" />
                </Border>
              </StackPanel>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BeadCardViewModel">
                        <Border Classes="card"
                                DoubleTapped="OnCardDoubleTapped"
                                PointerPressed="OnCardPointerPressed"
                                ToolTip.Tip="{Binding StatusText}">
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding PriorityText}" Classes="tiny" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Border Background="{DynamicResource PanelAltBackground}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="{Binding TypeText}" Classes="tiny" />
                              </Border>
                              <TextBlock Text="{Binding Id}" Classes="tiny" VerticalAlignment="Center" />
                              <TextBlock Text="阻塞" Classes="tiny" Foreground="{DynamicResource DangerBrush}"
                                         VerticalAlignment="Center" IsVisible="{Binding IsBlocked}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding OwnerText}" Classes="tiny" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding CommentCount, StringFormat='评论 {0}'}" Classes="tiny" />
                                <TextBlock Text="{Binding DependencyCount, StringFormat='依赖 {0}'}" Classes="tiny" />
                                <TextBlock Text="{Binding AttributionText}" Classes="tiny"
                                           Foreground="{DynamicResource PurpleBrush}" />
                                <TextBlock Text="{Binding RelativeUpdated}" Classes="tiny" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="暂无任务" Classes="tiny" Margin="2,4,0,0"
                             IsVisible="{Binding IsEmpty}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
