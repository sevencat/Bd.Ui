<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bd.Core.ViewModels"
             x:Class="Bd.App.Views.BeadDetailView"
             x:DataType="vm:BeadDetailViewModel">
  <Border Classes="panel" CornerRadius="0" Padding="16">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MetaText}" Classes="tiny" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Classes="ghost" Command="{Binding CloseCommand}"
                VerticalAlignment="Top" />
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource PanelAltBackground}" CornerRadius="6"
              Padding="10" Margin="0,10,0,0">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TypeText}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PriorityText}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AttributionText}" Classes="tiny"
                       Foreground="{DynamicResource PurpleBrush}" VerticalAlignment="Center" />
            <TextBlock Text="已归档" Classes="tiny" Foreground="{DynamicResource WarningBrush}"
                       VerticalAlignment="Center" IsVisible="{Binding IsArchived}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox Width="130" ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
            <TextBox Width="140" PlaceholderText="指派给"
                     Text="{Binding AssigneeInput, Mode=TwoWay}" />
            <Button Content="保存" Classes="primary" Command="{Binding SaveCommand}"
                    IsVisible="{Binding CanEdit}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4" IsVisible="{Binding HasChildren}">
            <TextBlock Text="子任务进度" Classes="muted" />
            <Grid ColumnDefinitions="*,Auto">
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressRatio}" />
              <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Classes="muted" Margin="10,0,0,0" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="描述" Classes="h2" />
            <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="依赖" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Dependencies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailDependencyRow">
                  <Border Background="{DynamicResource PanelAltBackground}" CornerRadius="6"
                          Padding="8,5" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding TargetId}" Classes="tiny" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding TypeText}" Classes="tiny" Margin="10,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="tiny"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding HasChildren}">
            <TextBlock Text="子任务" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Children}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailChildRow">
                  <Border Background="{DynamicResource PanelAltBackground}" CornerRadius="6"
                          Padding="8,5" Margin="0,0,0,4"
                          DoubleTapped="OnChildDoubleTapped">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding Id}" Classes="tiny" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="tiny"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="评论" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Comments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailCommentRow">
                  <Border Background="{DynamicResource PanelAltBackground}" CornerRadius="6"
                          Padding="8" Margin="0,0,0,6">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Author}" Classes="tiny" />
                        <TextBlock Text="{Binding CreatedText}" Classes="tiny" />
                      </StackPanel>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                     PlaceholderText="写下评论…" Text="{Binding CommentText, Mode=TwoWay}" />
            <Button Content="添加评论" HorizontalAlignment="Left" Command="{Binding AddCommentCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
        <Button Content="归档" Command="{Binding ArchiveCommand}" IsVisible="{Binding !IsArchived}" />
        <Button Content="删除" Classes="danger" Command="{Binding DeleteCommand}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
