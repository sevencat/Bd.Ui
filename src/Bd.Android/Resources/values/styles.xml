<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- AvaloniaActivity 继承 AppCompatActivity，主题必须以 AppCompat 为父；
       深色无标题栏，与 Avalonia 的 Dark 变体一致，避免启动时白闪 -->
  <style name="BdTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">#FF12141A</item>
    <item name="android:statusBarColor">#FF1B1E26</item>
    <item name="android:navigationBarColor">#FF1B1E26</item>
  </style>
</resources>
