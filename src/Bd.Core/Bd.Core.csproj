<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bd.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmVersion)" />
    <!-- net11 起 Microsoft.Extensions.Logging.Abstractions 已随共享框架提供，显式引用会触发 NU1510 -->
    <PackageReference Include="MySqlConnector" Version="$(MySqlConnectorVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- DoltSql / DoltStore 的映射与 SQL 拼装需要在不连库的前提下做单测。 -->
    <InternalsVisibleTo Include="Bd.Core.Tests" />
  </ItemGroup>

</Project>
